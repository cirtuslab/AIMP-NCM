#include "resource.h"
#include <windows.h>
#pragma code_page(65001)

#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

IDD_NCM_SETTINGS DIALOGEX 0, 0, 420, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AIMP NCM 网易云设置"
FONT 9, "Microsoft YaHei", 400, 0, 0x1
BEGIN
    GROUPBOX        "服务器与登录",IDC_STATIC,7,7,406,90
    LTEXT           "API 地址 (镜像):",IDC_STATIC,15,20,70,8
    EDITTEXT        IDC_APIURL,90,18,200,14,ES_AUTOHSCROLL
    LTEXT           "Cookie (MUSIC_U):",IDC_STATIC,15,38,70,8
    EDITTEXT        IDC_COOKIE,90,36,200,14,ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON      "二维码登录",IDC_BTN_QR,300,36,70,14
    LTEXT           "UID:",IDC_STATIC,15,56,30,8
    EDITTEXT        IDC_UID,90,54,100,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "状态:",IDC_STATIC,15,74,30,8
    LTEXT           "就绪",IDC_STATUS,50,74,340,12

    GROUPBOX        "音质与歌单",IDC_STATIC,7,105,406,170
    LTEXT           "音质:",IDC_STATIC,15,125,30,8
    COMBOBOX        IDC_COMBO_QUALITY,50,123,120,80,CBS_DROPDOWNLIST | WS_VSCROLL
    PUSHBUTTON      "刷新歌单",IDC_BTN_REFRESH,180,123,60,14
    LTEXT           "勾选要同步的歌单:",IDC_STATIC,15,145,100,8
    LISTBOX         IDC_LIST_PLAYLISTS,15,158,390,100,LBS_EXTENDEDSEL | LBS_HASSTRINGS | WS_VSCROLL | WS_BORDER

    PUSHBUTTON      "清除配置",IDC_BTN_CLEAR,15,285,60,14
    DEFPUSHBUTTON   "保存并同步到播放列表",IDOK,140,285,150,14
    PUSHBUTTON      "关闭",IDCANCEL,300,285,60,14
END

IDD_NCM_LOGIN DIALOGEX 0, 0, 340, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "二维码登录"
FONT 9, "Microsoft YaHei", 400, 0, 0x1
BEGIN
    LTEXT           "状态:",IDC_STATIC,10,10,40,8
    LTEXT           "点击获取二维码",IDC_QR_STATUS,50,10,280,30
    CONTROL         "",2003,"Static",SS_BITMAP|SS_REALSIZEIMAGE|SS_CENTERIMAGE|WS_BORDER,70,45,200,200
    PUSHBUTTON      "获取二维码",IDC_BTN_GETQR,70,255,80,14
    DEFPUSHBUTTON   "关闭",IDCANCEL,190,255,50,14
END
